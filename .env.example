# ── Neon PostgreSQL ───────────────────────────────────────────────────────────
# Copy this file to `.env` and paste your Neon connection string.
# Neon dashboard → Project → Connect → copy the POOLED connection string.
# Server-side only — never prefix with VITE_.
DATABASE_URL="postgresql://neondb_owner:REPLACE_WITH_YOUR_PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"